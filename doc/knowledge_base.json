{
  "project": {
    "name": "ML Compass",
    "description": "Expert system knowledge base for beginner-friendly machine learning model selection.",
    "version": "1.0",
    "reasoning_type": "rule_based_goal_driven"
  },
  "input_schema": {
    "has_target_column": "boolean | unknown",
    "target_type": "categorical | continuous_numeric | numeric_label | unknown",
    "target_unique_classes": "number | unknown",
    "can_have_multiple_labels": "boolean | unknown",
    "data_type": "tabular | text | image | time_series | multimodal | unknown",
    "text_complexity": "simple | complex | unknown",
    "dataset_rows": "number | unknown",
    "class_balance": "balanced | imbalanced | unknown",
    "majority_class_percentage": "number | unknown",
    "missing_value_percentage": "number | unknown",
    "missing_value_type": "numerical | categorical | mixed | unknown",
    "has_outliers": "boolean | unknown",
    "goal": "classification | regression | grouping | anomaly_detection | forecasting | nlp | unknown",
    "priority": "transparency | performance | balanced | unknown",
    "domain": "general | medical | legal | financial | educational | unknown",
    "has_gpu": "boolean | unknown",
    "timeline": "short | medium | long | unknown",
    "programming_skill": "beginner | intermediate | advanced | unknown"
  },
  "thresholds": {
    "small_dataset_rows_lt": 1000,
    "medium_dataset_rows_min": 1000,
    "medium_dataset_rows_max": 100000,
    "large_dataset_rows_gt": 100000,
    "low_missing_percentage_lt": 5,
    "high_missing_feature_percentage_gt": 40,
    "imbalanced_majority_class_percentage_gt": 80
  },
  "rule_priority_order": [
    "ml_necessity",
    "task_type",
    "data_type",
    "dataset_size",
    "practical_constraints",
    "preprocessing",
    "evaluation_metrics",
    "final_validation"
  ],
  "rules": [
    {
      "id": "R001",
      "category": "ml_necessity",
      "name": "Machine Learning Necessity",
      "if": {
        "any": [
          "output_can_be_calculated_by_formula == true",
          "decision_follows_simple_fixed_rule == true"
        ]
      },
      "then": {
        "recommendation": "Use rule-based logic or standard statistics",
        "use_machine_learning": false,
        "warning": "Machine learning is not needed because the answer can be obtained directly."
      }
    },
    {
      "id": "R002",
      "category": "ml_necessity",
      "name": "Hidden Pattern Requirement",
      "if": {
        "all": [
          "relationship_between_input_and_output == not_obvious",
          "needs_to_learn_from_past_data == true"
        ]
      },
      "then": {
        "use_machine_learning": true,
        "reason": "Machine learning is suitable because the pattern is hidden in historical data."
      }
    },
    {
      "id": "R003",
      "category": "priority_filter",
      "name": "Transparency Priority",
      "if": {
        "any": [
          "priority == transparency",
          "domain in [medical, legal, financial, educational]"
        ]
      },
      "then": {
        "model_preference": [
          "Logistic Regression",
          "Linear Regression",
          "Decision Tree",
          "Rule-Based Model"
        ],
        "reason": "Sensitive or explainable projects need models that are easier to justify."
      }
    },
    {
      "id": "R004",
      "category": "priority_filter",
      "name": "Performance Priority",
      "if": {
        "all": [
          "priority == performance",
          "explainability_required == false",
          "dataset_rows >= 100000"
        ]
      },
      "then": {
        "model_preference": [
          "Random Forest",
          "XGBoost",
          "LightGBM",
          "CNN",
          "LSTM",
          "BERT",
          "Transformer"
        ],
        "reason": "When accuracy is more important than explainability, stronger models may be suitable."
      }
    },
    {
      "id": "R005",
      "category": "task_type",
      "name": "Classification Task",
      "if": {
        "all": [
          "has_target_column == true",
          "target_type == categorical"
        ]
      },
      "then": {
        "problem_type": "classification",
        "reason": "The target output is a category or class."
      }
    },
    {
      "id": "R006",
      "category": "task_type",
      "name": "Regression Task",
      "if": {
        "all": [
          "has_target_column == true",
          "target_type == continuous_numeric"
        ]
      },
      "then": {
        "problem_type": "regression",
        "reason": "The target output is a continuous number."
      }
    },
    {
      "id": "R007",
      "category": "task_type",
      "name": "Clustering Task",
      "if": {
        "all": [
          "has_target_column == false",
          "goal == grouping"
        ]
      },
      "then": {
        "problem_type": "clustering",
        "reason": "There is no target column and the goal is to group similar data."
      }
    },
    {
      "id": "R008",
      "category": "task_type",
      "name": "Anomaly Detection Task",
      "if": {
        "any": [
          "goal == anomaly_detection",
          "goal == rare_pattern_detection"
        ]
      },
      "then": {
        "problem_type": "anomaly_detection",
        "reason": "The goal is to find rare or abnormal cases."
      }
    },
    {
      "id": "R009",
      "category": "task_type",
      "name": "Time Series Forecasting Task",
      "if": {
        "all": [
          "data_type == time_series",
          "goal == forecasting"
        ]
      },
      "then": {
        "problem_type": "time_series_forecasting",
        "reason": "The data is ordered by time and the goal is to predict future values."
      }
    },
    {
      "id": "R010",
      "category": "task_type",
      "name": "NLP / LLM Task",
      "if": {
        "any": [
          "data_type == text",
          "goal == nlp",
          "goal in [summarization, translation, question_answering, text_generation]"
        ]
      },
      "then": {
        "problem_type": "nlp",
        "reason": "The task depends on understanding or generating human language."
      }
    },
    {
      "id": "R011",
      "category": "numeric_trap",
      "name": "Numeric Category Rule",
      "if": {
        "all": [
          "target_type == numeric_label",
          "number_difference_has_real_quantity_meaning == false"
        ]
      },
      "then": {
        "problem_type": "classification",
        "reason": "Numbers are used as labels, not real measurable values."
      }
    },
    {
      "id": "R012",
      "category": "numeric_trap",
      "name": "Continuous Quantity Rule",
      "if": {
        "all": [
          "target_type == continuous_numeric",
          "number_difference_has_real_quantity_meaning == true"
        ]
      },
      "then": {
        "problem_type": "regression",
        "reason": "The number difference has real measurable meaning."
      }
    },
    {
      "id": "R013",
      "category": "data_type",
      "name": "Tabular Data Model Family",
      "if": {
        "all": [
          "data_type == tabular"
        ]
      },
      "then": {
        "recommended_model_family": "traditional_machine_learning",
        "baseline_models": [
          "Logistic Regression",
          "Linear Regression",
          "Decision Tree"
        ],
        "advanced_models": [
          "Random Forest",
          "XGBoost",
          "LightGBM"
        ]
      }
    },
    {
      "id": "R014",
      "category": "data_type",
      "name": "Simple Text Data",
      "if": {
        "all": [
          "data_type == text",
          "text_complexity == simple"
        ]
      },
      "then": {
        "preprocessing": [
          "TF-IDF"
        ],
        "recommended_models": [
          "Naive Bayes",
          "Logistic Regression",
          "SVM"
        ],
        "reason": "Simple text tasks can often be solved using keyword-frequency features."
      }
    },
    {
      "id": "R015",
      "category": "data_type",
      "name": "Complex Text Data",
      "if": {
        "any": [
          "data_type == text AND text_complexity == complex",
          "word_order_is_important == true",
          "context_understanding_required == true"
        ]
      },
      "then": {
        "recommended_models": [
          "LSTM",
          "BERT",
          "Transformer"
        ],
        "warning": "Use these only if dataset size and resources are enough."
      }
    },
    {
      "id": "R016",
      "category": "data_type",
      "name": "Image Data",
      "if": {
        "all": [
          "data_type == image"
        ]
      },
      "then": {
        "recommended_models": [
          "CNN",
          "ResNet",
          "Vision Transformer"
        ],
        "reason": "Image data contains spatial pixel patterns."
      }
    },
    {
      "id": "R017",
      "category": "data_type",
      "name": "Time Series Data",
      "if": {
        "all": [
          "data_type == time_series",
          "past_values_affect_future_values == true"
        ]
      },
      "then": {
        "recommended_models": [
          "ARIMA",
          "Prophet",
          "XGBoost with lag features",
          "LSTM",
          "GRU"
        ],
        "reason": "Chronological order matters."
      }
    },
    {
      "id": "R018",
      "category": "data_type",
      "name": "Multi-Modal Data",
      "if": {
        "all": [
          "data_type == multimodal"
        ]
      },
      "then": {
        "strategy": [
          "Identify dominant data type",
          "Extract features from secondary data type",
          "Combine features for final prediction"
        ]
      }
    },
    {
      "id": "R019",
      "category": "learning_type",
      "name": "Supervised Learning",
      "if": {
        "all": [
          "has_target_column == true",
          "labeled_data_available == true"
        ]
      },
      "then": {
        "learning_type": "supervised_learning"
      }
    },
    {
      "id": "R020",
      "category": "learning_type",
      "name": "Unlabeled Data Clustering",
      "if": {
        "all": [
          "has_target_column == false",
          "goal == grouping"
        ]
      },
      "then": {
        "learning_type": "unsupervised_learning",
        "problem_type": "clustering"
      }
    },
    {
      "id": "R021",
      "category": "learning_type",
      "name": "Unlabeled Data Anomaly Detection",
      "if": {
        "all": [
          "has_target_column == false",
          "goal == anomaly_detection"
        ]
      },
      "then": {
        "learning_type": "unsupervised_or_semi_supervised_anomaly_detection"
      }
    },
    {
      "id": "R022",
      "category": "learning_type",
      "name": "Semi-Supervised Approach",
      "if": {
        "all": [
          "has_target_column == false",
          "labeling_possible == true"
        ]
      },
      "then": {
        "recommendation": "Use semi-supervised learning or pseudo-labeling"
      }
    },
    {
      "id": "R023",
      "category": "learning_type",
      "name": "Rule-Based Labeling",
      "if": {
        "all": [
          "has_target_column == false",
          "domain_rules_can_create_labels == true"
        ]
      },
      "then": {
        "recommendation": "Create labels using domain rules before training a supervised model"
      }
    },
    {
      "id": "R024",
      "category": "learning_type",
      "name": "Pseudo-Labeling",
      "if": {
        "all": [
          "has_target_column == false",
          "clustering_produces_meaningful_groups == true"
        ]
      },
      "then": {
        "recommendation": "Use cluster IDs as pseudo-labels for classification"
      }
    },
    {
      "id": "R025",
      "category": "dataset_size",
      "name": "Small Dataset",
      "if": {
        "all": [
          "dataset_rows < 1000"
        ]
      },
      "then": {
        "recommended_models": [
          "Logistic Regression",
          "Linear Regression",
          "Decision Tree",
          "Naive Bayes",
          "SVM",
          "KNN"
        ],
        "avoid_first": [
          "CNN",
          "LSTM",
          "BERT",
          "Transformer"
        ],
        "warning": "Small datasets have higher overfitting risk."
      }
    },
    {
      "id": "R026",
      "category": "dataset_size",
      "name": "Medium Dataset",
      "if": {
        "all": [
          "dataset_rows >= 1000",
          "dataset_rows <= 100000"
        ]
      },
      "then": {
        "recommended_models": [
          "Random Forest",
          "XGBoost",
          "LightGBM",
          "SVM"
        ]
      }
    },
    {
      "id": "R027",
      "category": "dataset_size",
      "name": "Large Dataset",
      "if": {
        "all": [
          "dataset_rows > 100000",
          "problem_complexity == high"
        ]
      },
      "then": {
        "recommended_models": [
          "CNN",
          "LSTM",
          "GRU",
          "BERT",
          "Transformer"
        ]
      }
    },
    {
      "id": "R028",
      "category": "dataset_size",
      "name": "Overfitting Warning",
      "if": {
        "all": [
          "dataset_rows < 1000",
          "selected_model in [CNN, LSTM, BERT, Transformer]"
        ]
      },
      "then": {
        "warning": "Complex model on small dataset may memorize noise instead of learning patterns.",
        "recommendation": "Start with a simpler baseline model."
      }
    },
    {
      "id": "R029",
      "category": "dataset_size",
      "name": "Baseline Model Rule",
      "if": {
        "all": [
          "student_has_trained_model_before == false"
        ]
      },
      "then": {
        "recommendation": "Start with a simple baseline model before advanced models."
      }
    },
    {
      "id": "R030",
      "category": "preprocessing",
      "name": "Scaling Required",
      "if": {
        "any": [
          "selected_model in [SVM, KNN, Logistic Regression, Neural Network]"
        ]
      },
      "then": {
        "preprocessing": [
          "Standardization",
          "Normalization"
        ],
        "reason": "Distance and gradient-based models are affected by feature scale."
      }
    },
    {
      "id": "R031",
      "category": "preprocessing",
      "name": "Scaling Optional for Tree Models",
      "if": {
        "any": [
          "selected_model in [Decision Tree, Random Forest, XGBoost, LightGBM]"
        ]
      },
      "then": {
        "preprocessing": [
          "Feature scaling optional"
        ],
        "reason": "Tree models split using thresholds and are less affected by scale."
      }
    },
    {
      "id": "R032",
      "category": "preprocessing",
      "name": "Ordinal Encoding",
      "if": {
        "all": [
          "categorical_feature_order == natural_order"
        ]
      },
      "then": {
        "preprocessing": [
          "Label Encoding"
        ]
      }
    },
    {
      "id": "R033",
      "category": "preprocessing",
      "name": "Nominal Encoding",
      "if": {
        "all": [
          "categorical_feature_order == no_order"
        ]
      },
      "then": {
        "preprocessing": [
          "One-Hot Encoding"
        ],
        "reason": "Avoid creating fake ranking between categories."
      }
    },
    {
      "id": "R034",
      "category": "preprocessing",
      "name": "High Cardinality Encoding",
      "if": {
        "all": [
          "categorical_unique_values > 100"
        ]
      },
      "then": {
        "preprocessing": [
          "Target Encoding"
        ],
        "warning": "Too many one-hot columns can make the dataset too large."
      }
    },
    {
      "id": "R035",
      "category": "preprocessing",
      "name": "Low Missing Values",
      "if": {
        "all": [
          "missing_value_percentage < 5"
        ]
      },
      "then": {
        "preprocessing": [
          "Remove affected rows if dataset size remains acceptable"
        ]
      }
    },
    {
      "id": "R036",
      "category": "preprocessing",
      "name": "Missing Numerical Values",
      "if": {
        "all": [
          "missing_value_type == numerical"
        ]
      },
      "then": {
        "preprocessing": [
          "Median Imputation"
        ]
      }
    },
    {
      "id": "R037",
      "category": "preprocessing",
      "name": "Missing Categorical Values",
      "if": {
        "all": [
          "missing_value_type == categorical"
        ]
      },
      "then": {
        "preprocessing": [
          "Mode Imputation",
          "Create Unknown category"
        ]
      }
    },
    {
      "id": "R038",
      "category": "evaluation_metrics",
      "name": "Balanced Classification Metric",
      "if": {
        "all": [
          "problem_type == classification",
          "class_balance == balanced"
        ]
      },
      "then": {
        "metrics": [
          "Accuracy"
        ]
      }
    },
    {
      "id": "R039",
      "category": "evaluation_metrics",
      "name": "Imbalanced Classification Metric",
      "if": {
        "any": [
          "class_balance == imbalanced",
          "majority_class_percentage > 80"
        ]
      },
      "then": {
        "metrics": [
          "F1-Score",
          "Precision",
          "Recall",
          "PR-AUC"
        ],
        "warning": "Accuracy alone may be misleading for imbalanced data."
      }
    },
    {
      "id": "R040",
      "category": "evaluation_metrics",
      "name": "High False Negative Cost",
      "if": {
        "all": [
          "false_negative_cost == high"
        ]
      },
      "then": {
        "metrics": [
          "Recall"
        ]
      }
    },
    {
      "id": "R041",
      "category": "evaluation_metrics",
      "name": "High False Positive Cost",
      "if": {
        "all": [
          "false_positive_cost == high"
        ]
      },
      "then": {
        "metrics": [
          "Precision"
        ]
      }
    },
    {
      "id": "R042",
      "category": "evaluation_metrics",
      "name": "Regression RMSE",
      "if": {
        "all": [
          "problem_type == regression",
          "has_outliers == false"
        ]
      },
      "then": {
        "metrics": [
          "RMSE"
        ]
      }
    },
    {
      "id": "R043",
      "category": "evaluation_metrics",
      "name": "Regression MAE",
      "if": {
        "all": [
          "problem_type == regression",
          "has_outliers == true"
        ]
      },
      "then": {
        "metrics": [
          "MAE"
        ]
      }
    },
    {
      "id": "R044",
      "category": "evaluation_metrics",
      "name": "Regression R2 Score",
      "if": {
        "all": [
          "problem_type == regression",
          "wants_variance_explanation == true"
        ]
      },
      "then": {
        "metrics": [
          "R2 Score"
        ]
      }
    },
    {
      "id": "R045",
      "category": "practical_constraints",
      "name": "Resource Limitation",
      "if": {
        "any": [
          "timeline == short",
          "has_gpu == false",
          "programming_skill == beginner"
        ]
      },
      "then": {
        "prefer_models": [
          "Logistic Regression",
          "Linear Regression",
          "Decision Tree",
          "Naive Bayes"
        ],
        "avoid_first": [
          "CNN",
          "LSTM",
          "BERT",
          "Transformer"
        ]
      }
    },
    {
      "id": "R046",
      "category": "conflict_handling",
      "name": "Dataset Size Overrides Complexity",
      "if": {
        "all": [
          "recommended_model_complexity == high",
          "dataset_rows < 1000"
        ]
      },
      "then": {
        "override": "Use simpler baseline first",
        "reason": "Small data is more important than model ambition."
      }
    },
    {
      "id": "R047",
      "category": "confidence",
      "name": "High Confidence Recommendation",
      "if": {
        "all": [
          "task_type_known == true",
          "data_type_known == true",
          "dataset_size_known == true",
          "metric_known == true",
          "no_major_rule_conflict == true"
        ]
      },
      "then": {
        "confidence": "high"
      }
    },
    {
      "id": "R048",
      "category": "confidence",
      "name": "Medium Confidence Recommendation",
      "if": {
        "all": [
          "task_type_known == true",
          "data_type_known == true"
        ],
        "any": [
          "dataset_size_known == false",
          "class_balance == unknown",
          "missing_value_percentage == unknown"
        ]
      },
      "then": {
        "confidence": "medium",
        "action": "Ask follow-up questions or give temporary recommendation."
      }
    },
    {
      "id": "R049",
      "category": "confidence",
      "name": "Low Confidence Recommendation",
      "if": {
        "any": [
          "task_type_known == false",
          "data_type_known == false",
          "major_rule_conflict == true"
        ]
      },
      "then": {
        "confidence": "low",
        "warning": "Important information is missing or rules conflict."
      }
    },
    {
      "id": "R050",
      "category": "missing_input",
      "name": "Missing Target Column",
      "if": {
        "all": [
          "has_target_column == unknown"
        ]
      },
      "then": {
        "ask": "What do you want to predict?",
        "temporary_recommendation": "Cannot confirm supervised or unsupervised learning yet."
      }
    },
    {
      "id": "R051",
      "category": "missing_input",
      "name": "Missing Dataset Size",
      "if": {
        "all": [
          "dataset_rows == unknown"
        ]
      },
      "then": {
        "temporary_recommendation": "Start with simple baseline models first.",
        "confidence_modifier": "decrease"
      }
    },
    {
      "id": "R052",
      "category": "missing_input",
      "name": "Missing Class Balance",
      "if": {
        "all": [
          "problem_type == classification",
          "class_balance == unknown"
        ]
      },
      "then": {
        "metrics": [
          "Accuracy",
          "F1-Score"
        ],
        "warning": "Accuracy may be misleading if the classes are imbalanced."
      }
    },
    {
      "id": "R053",
      "category": "data_quality",
      "name": "Duplicate Rows",
      "if": {
        "all": [
          "duplicate_rows_exist == true"
        ]
      },
      "then": {
        "warning": "Duplicate rows may bias the model.",
        "preprocessing": [
          "Remove duplicate rows"
        ]
      }
    },
    {
      "id": "R054",
      "category": "data_quality",
      "name": "Data Leakage",
      "if": {
        "all": [
          "feature_directly_reveals_target == true"
        ]
      },
      "then": {
        "warning": "Data leakage detected. Remove this feature before training.",
        "severity": "high"
      }
    },
    {
      "id": "R055",
      "category": "data_quality",
      "name": "Too Many Missing Values in Feature",
      "if": {
        "all": [
          "feature_missing_percentage > 40"
        ]
      },
      "then": {
        "recommendation": "Drop the feature or ask whether the feature is important."
      }
    },
    {
      "id": "R056",
      "category": "task_type",
      "name": "Binary Classification",
      "if": {
        "all": [
          "problem_type == classification",
          "target_unique_classes == 2"
        ]
      },
      "then": {
        "classification_type": "binary_classification"
      }
    },
    {
      "id": "R057",
      "category": "task_type",
      "name": "Multi-Class Classification",
      "if": {
        "all": [
          "problem_type == classification",
